APP_NAME="EDI Integration Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_DEMO_MODE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=edi_hub
# DB_USERNAME=edi
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@edi-hub.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# EDI Integration Hub
EDI_HUB_NAME="EDI Integration Hub"
EDI_HUB_DELIVERY_DRIVER=mock
# mock | as2 | sftp | rest  (as2 is sandbox: writes storage/app/as2-out)
EDI_HUB_DEMO_MODE=true
EDI_HUB_TRIAL_DAYS=14
EDI_HUB_QUEUE=default
EDI_HUB_EDI_QUEUE=edi
EDI_HUB_BILLING_QUEUE=billing
EDI_HUB_NOTIFICATIONS_QUEUE=notifications
EDI_HUB_AUDIT_RETENTION_DAYS=365
EDI_HUB_LOGIN_HISTORY_RETENTION_DAYS=90
EDI_HUB_MODULE_ACTIVITY_RETENTION_DAYS=180
EDI_HUB_EDI_PAYLOAD_RETENTION_DAYS=90

# Demo sandbox users (local password applies when APP_ENV=local)
DEMO_PASSWORD=demo-change-me
DEMO_EMAIL_PLATFORM=demo.platform@edi-hub.test
DEMO_EMAIL_OWNER=demo.owner@edi-hub.test
DEMO_EMAIL_EDI=demo.edi@edi-hub.test
DEMO_EMAIL_INTEGRATOR=demo.integrator@edi-hub.test
DEMO_EMAIL_OPS=demo.ops@edi-hub.test
DEMO_EMAIL_BUYER=demo.buyer@edi-hub.test
DEMO_EMAIL_SUPPLIER=demo.supplier@edi-hub.test
DEMO_EMAIL_AUDITOR=demo.auditor@edi-hub.test

# ImranDev AI Hub (optional)
AI_HUB_ENABLED=false
# AI_HUB_PROVIDER=
# AI_HUB_API_KEY=

# Drutogoti observability (optional)
DRUTOGOTI_ENABLED=false
# DRUTOGOTI_SAMPLE_RATE=0.1
